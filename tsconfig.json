{
  "compilerOptions": {
    "outDir": "./dist",
    "target": "ES2023",
    "lib": ["DOM", "ESNext"],
    "module": "nodenext",
    "strict": true,
    "declaration": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    "types": ["node"],
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"],
  "exclude": ["src/compiled"]
}
